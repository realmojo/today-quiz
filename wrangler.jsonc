{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "today-quiz",
  // 커스텀 엔트리: OpenNext 핸들러 앞단 엣지 캐시 (worker.ts 참고)
  "main": "worker.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // 배포할 때 대시보드에서 설정한 환경 변수를 지우지 않는다.
  // wrangler deploy는 기본적으로 이 파일을 설정의 단일 원본으로 보고,
  // 여기에 없는 일반 텍스트 변수를 전부 삭제한다. keep_vars가 그 동작을 끈다.
  // (Secret은 원래 영향을 받지 않지만, plain text vars는 이 옵션이 없으면 날아간다)
  "keep_vars": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
